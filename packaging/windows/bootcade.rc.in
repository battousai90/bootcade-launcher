// Ressources de bootcade.exe : l'icone de l'Explorateur et la fiche
// « Details » des proprietes du fichier. Genere par CMake (configure_file).
#include <winver.h>

1 ICON "bootcade.ico"

// Manifeste : page de codes UTF-8, chemins longs, niveau d'execution.
1 24 "bootcade.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "battousai90\0"
            VALUE "FileDescription",  "Bootcade\0"
            VALUE "FileVersion",      "@BOOTCADE_VERSION_STRING@\0"
            VALUE "InternalName",     "bootcade\0"
            VALUE "OriginalFilename", "bootcade.exe\0"
            VALUE "ProductName",      "Bootcade\0"
            VALUE "ProductVersion",   "@BOOTCADE_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
